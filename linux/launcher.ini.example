# MapleStory 2 (Offline) launcher settings, Linux edition. This file is yours: updates never touch it.
# Remove a line to use the default from defaults.ini (shipped with each release).

# Folder of MapleStory2.exe (the x64 folder of your Steam install). Found automatically when not set:
# the program folder's own "client" folder, then every Steam library (steamapps/common/MapleStory 2).
#ClientDir=/home/you/.local/share/Steam/steamapps/common/MapleStory 2/x64

# Rules: Adapted (built for playing alone, the default) or Legacy (the original online-era rules).
# See docs/ADAPTATIONS.md of the project, A19.
GameMode=Adapted

# Single options win over the mode. Uncomment a line to turn that option on or off whatever the mode says.
#GrindRates=true
#DungeonAllDrops=true
#UnlimitedDungeonClears=true
#ClassDropsOnly=true
#PetTaming=true
#DungeonEpicGear=true
#PartyDungeons=true
#FairFight=true
#BlackMarket=true
# Chat commands /godmode, /killall, /unstuck, /freebies, /give, /item, /find.
#CheatCommands=true
# Same in both modes (on unless set to false):
#MailNeverExpires=true

# Online update check when you press Play: ask, always (no question) or off (manual: ms2offline update).
AutoUpdate=ask

# After every session a plain-text report goes to the "reports" folder in the program folder.
DebugReports=true

# Problem reports to the developer after a session with a problem: always (default after the one-time notice; the
# checkbox in the window), ask or never. The notice and each question show what a report contains; your names, chat
# and save are never sent.
#SendReports=always
# ReportNotice=1 is written by the launcher once the notice was shown.

# Unified content (Korean and Japanese records and art) on the Global client: true (default) or false (pure Global game; Play removes it again).
#UnifiedContent=true

# ---- Linux ----
# Proton build for the game: a name in ~/.local/share/Steam/compatibilitytools.d, a folder, or "GE-Proton"
# for the newest GE-Proton (umu downloads it). Default: GE-Proton10-28 when installed, else GE-Proton.
#Proton=GE-Proton10-28

# The game's Wine prefix (default: the "prefix" folder in the program folder).
#Prefix=~/Games/MapleStory2-Offline/prefix

# Extra environment for the game, KEY=VALUE pairs separated by ";" (for example a MangoHud or DXVK setting).
#LaunchEnv=MANGOHUD=1;DXVK_HUD=fps

# Shows the client patch's own console log window (debugging).
ClientConsole=false

# Save profile: a sub-folder of SaveData for a separate game ("" = the main save), as on Windows.
#Profile=

# Developer options - leave off for normal play.
TestKit=false
TriggerTrace=false
