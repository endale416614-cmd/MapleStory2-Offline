<Project Sdk="Microsoft.NET.Sdk">

    <!-- Tests for launcher code that does not need WinForms: the sources are linked, not referenced. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>MapleStory2Offline.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Launcher\ReleaseManifest.cs" Link="Linked\ReleaseManifest.cs" />
        <Compile Include="..\Launcher\UpdateKey.cs" Link="Linked\UpdateKey.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    </ItemGroup>

</Project>
