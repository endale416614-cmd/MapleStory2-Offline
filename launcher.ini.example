# MapleStory 2 (Offline) launcher settings. Copy to launcher.ini to change them; remove a line to use the default.

# Folder of MapleStory2.exe (the x64 folder of your Steam install).
#ClientDir=C:\Program Files (x86)\Steam\steamapps\common\MapleStory 2\x64

# Rules: Adapted (solo-friendly changes, the default) or Legacy (the original game). The launcher asks at every start
# ("Choose how to play") and writes the choice here. See docs/ADAPTATIONS.md, A19.
GameMode=Adapted

# Single options win over the mode. Uncomment a line to turn that option on or off whatever the mode says.
#GrindRates=true
#DungeonAllDrops=true
#UnlimitedDungeonClears=true
#MailNeverExpires=true
#PartyDungeons=true
#FairFight=true
#BlackMarket=true
#ClassDropsOnly=true
#PetTaming=true
#DungeonEpicGear=true
# Chat commands /godmode, /killall, /unstuck, /freebies (for quests or places you get stuck in).
#CheatCommands=true

# Online update check when you press Play: ask, always (no question) or off (manual updates only).
AutoUpdate=ask

# After every session a plain-text report goes to "MapleStory 2 Offline Reports" on the desktop.
DebugReports=true

# Problem reports to the developer after a session with a problem: always (default after the one-time notice; the
# checkbox in "Choose how to play"), ask or never. The notice and each question show what a report contains; your
# names, chat and save are never sent.
#SendReports=always
# ReportNotice=1 is written by the launcher once the notice was shown.

# Unified content (Korean and Japanese records and art) on the Global client: true (default) or false (pure Global game; Play removes it again).
#UnifiedContent=true

# Save profile: a sub-folder of SaveData for a separate game ("" = the main save). Picked in the "Choose how to play" window.
#Profile=

# Developer options - leave off for normal play.
TestKit=false
TriggerTrace=false
